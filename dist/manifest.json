{
    "manifest_version": 3,
    "name": "TabVault",
    "version": "1.0.0",
    "description": "열린 탭을 지식 자산으로 관리하세요.",
    "permissions": [
        "tabs",
        "storage"
    ],
    "host_permissions": [
        "https://api.notion.com/*"
    ],
    "action": {
        "default_popup": "popup.html"
    }
}