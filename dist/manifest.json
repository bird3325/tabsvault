{
    "manifest_version": 3,
    "name": "TabsVault - 열린 탭을 지식 자산으로",
    "version": "1.0.1",
    "description": "열린 탭을 지식 자산으로 관리하세요.",
    "permissions": [
        "tabs",
        "tabGroups"
    ],
    "host_permissions": [
        "https://api.notion.com/*"
    ],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "options_ui": {
        "page": "options.html",
        "open_in_tab": true
    }
}